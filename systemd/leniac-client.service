[Unit]
Description=Lenic Production HTTP Server
After=network.target

[Service]
Type=simple
User=obrymec
Group=obrymec
# UPDATE THIS PATH to match your actual project location
WorkingDirectory=/home/obrymec/leniac-develop  # or whatever the actual path is

# UPDATE THIS PATH as well
ExecStart=/usr/bin/python3 -m http.server 5700 --directory /home/obrymec/leniac-develop

Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=10

# Sécurité
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/home/obrymec/leniac-develop

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=leniac-client

[Install]
WantedBy=multi-user.target
